    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    
    <script>
        particlesJS("particles-js", {
            "particles": {
                "number": { "value": 80, "density": { "enable": true, "value_area": 800 } },
                "color": { "value": "#ff6b35" },
                "shape": { "type": "circle" },
                "opacity": { "value": 0.6, "random": true, "anim": { "enable": true, "speed": 1, "opacity_min": 0.2, "sync": false } },
                "size": { "value": 4, "random": true, "anim": { "enable": true, "speed": 2, "size_min": 1, "sync": false } },
                "line_linked": { "enable": true, "distance": 150, "color": "#ff6b35", "opacity": 0.3, "width": 1.5 },
                "move": { "enable": true, "speed": 2, "direction": "none", "random": false, "straight": false, "out_mode": "out", "bounce": false }
            },
            "interactivity": {
                "detect_on": "canvas",
                "events": { "onhover": { "enable": true, "mode": "grab" }, "onclick": { "enable": true, "mode": "push" }, "resize": true },
                "modes": { "grab": { "distance": 140, "line_linked": { "opacity": 0.6 } }, "push": { "particles_nb": 4 } }
            },
            "retina_detect": true
        });
        
        // LOADING SCREEN
        var loader = document.getElementById('loader');
        var loaderDots = document.getElementById('loaderDots');
        var dotCount = 0;
        
        var dotInterval = setInterval(function() {
            dotCount = (dotCount + 1) % 4;
            var dots = '';
            for (var i = 0; i < dotCount; i++) {
                dots += '.';
            }
            if (loaderDots) loaderDots.innerHTML = dots + '&nbsp;';
        }, 300);
        
        window.addEventListener('load', function() {
            clearInterval(dotInterval);
            setTimeout(function() {
                loader.classList.add('hidden');
                setTimeout(function() {
                    loader.style.display = 'none';
                }, 500);
            }, 500);
        });
        
        var menuBtn = document.getElementById('menuBtn');
        var mobileNav = document.getElementById('mobileNav');
        var overlayBg = document.getElementById('overlayBg');
        var scrollBtn = document.getElementById('scrollToTopBtn');
        var navbar = document.getElementById('navbar');
        var logoHome = document.getElementById('logoHome');
        
        var mobileClientsBtn = document.getElementById('mobileClientsBtn');
        var mobileServicesBtn = document.getElementById('mobileServicesBtn');
        var mobileClientsMenu = document.getElementById('mobileClientsMenu');
        var mobileServicesMenu = document.getElementById('mobileServicesMenu');
        
        var isTransitioning = false;
        
        // Fullscreen Navigation Functions
        function openFullscreenNav() {
            document.getElementById("fullscreenNav").style.height = "100%";
        }
        
        function closeFullscreenNav() {
            document.getElementById("fullscreenNav").style.height = "0%";
        }
        
        function showPage(pageId) {
            if (isTransitioning) return;
            
            var currentPage = document.querySelector('.page.active-page');
            var newPage = document.getElementById(pageId);
            
            if (!newPage || currentPage === newPage) return;
            
            isTransitioning = true;
            
            if (currentPage) {
                currentPage.classList.add('page-exit');
                setTimeout(function() {
                    var pages = document.querySelectorAll('.page');
                    for (var i = 0; i < pages.length; i++) {
                        pages[i].classList.remove('active-page', 'page-exit');
                    }
                    if (newPage) {
                        newPage.classList.add('active-page');
                    }
                    var navItems = document.querySelectorAll('.nav-item');
                    for (var i = 0; i < navItems.length; i++) {
                        navItems[i].classList.remove('active');
                    }
                    var activeDesktopItem = document.querySelector('.nav-item[data-page="' + pageId + '"]');
                    if (activeDesktopItem) {
                        activeDesktopItem.classList.add('active');
                    }
                    isTransitioning = false;
                }, 300);
            } else {
                var pages = document.querySelectorAll('.page');
                for (var i = 0; i < pages.length; i++) {
                    pages[i].classList.remove('active-page');
                }
                newPage.classList.add('active-page');
                isTransitioning = false;
            }
            
            mobileNav.classList.remove('active');
            overlayBg.classList.remove('active');
            menuBtn.classList.remove('active');
            document.body.style.overflow = '';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            setTimeout(function() {
                checkReveal();
            }, 350);
        }
        
        function toggleMobileMenu() {
            mobileNav.classList.toggle('active');
            overlayBg.classList.toggle('active');
            menuBtn.classList.toggle('active');
            if (mobileNav.classList.contains('active')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        }
        
        function checkReveal() {
            var revealItems = document.querySelectorAll('.reveal-item');
            var windowHeight = window.innerHeight;
            var revealThreshold = 100;
            
            for (var i = 0; i < revealItems.length; i++) {
                var element = revealItems[i];
                var elementTop = element.getBoundingClientRect().top;
                
                if (elementTop < windowHeight - revealThreshold) {
                    element.classList.add('revealed');
                }
            }
        }
        
        // SCROLL OBSERVER
        var scrollElements = document.querySelectorAll('.fade-up, .fade-left, .fade-right, .zoom-in');
        
        var observer = new IntersectionObserver(function(entries) {
            for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                    entries[i].target.classList.add('scrolled');
                }
            }
        }, { threshold: 0.2 });
        
        for (var i = 0; i < scrollElements.length; i++) {
            observer.observe(scrollElements[i]);
        }
        
        if (logoHome) {
            logoHome.onclick = function() { showPage('home'); };
        }
        
        var desktopNavItems = document.querySelectorAll('.nav-item[data-page]');
        for (var i = 0; i < desktopNavItems.length; i++) {
            desktopNavItems[i].addEventListener('click', function(e) {
                var page = this.getAttribute('data-page');
                if (page) showPage(page);
            });
        }
        
        var dropdownLinks = document.querySelectorAll('.dropdown-menu a');
        for (var i = 0; i < dropdownLinks.length; i++) {
            dropdownLinks[i].addEventListener('click', function(e) {
                e.stopPropagation();
                var page = this.getAttribute('data-page');
                if (page) showPage(page);
            });
        }
        
        var mobileNavItems = document.querySelectorAll('.nav-item-mobile[data-page]');
        for (var i = 0; i < mobileNavItems.length; i++) {
            mobileNavItems[i].addEventListener('click', function(e) {
                var page = this.getAttribute('data-page');
                if (page) showPage(page);
            });
        }
        
        var mobileDropdownLinks = document.querySelectorAll('.dropdown-menu-mobile a');
        for (var i = 0; i < mobileDropdownLinks.length; i++) {
            mobileDropdownLinks[i].addEventListener('click', function(e) {
                var page = this.getAttribute('data-page');
                if (page) showPage(page);
            });
        }
        
        if (mobileClientsBtn) {
            mobileClientsBtn.addEventListener('click', function(e) {
                e.preventDefault();
                mobileClientsMenu.classList.toggle('open');
            });
        }
        
        if (mobileServicesBtn) {
            mobileServicesBtn.addEventListener('click', function(e) {
                e.preventDefault();
                mobileServicesMenu.classList.toggle('open');
            });
        }
        
        menuBtn.addEventListener('click', toggleMobileMenu);
        overlayBg.addEventListener('click', toggleMobileMenu);
        
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
            if (document.documentElement.scrollTop > 200 || document.body.scrollTop > 200) {
                scrollBtn.classList.add('visible');
            } else {
                scrollBtn.classList.remove('visible');
            }
            checkReveal();
        });
        
        scrollBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        
        checkReveal();
    </script>
